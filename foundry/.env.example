# Supabase (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...

# LLM — OpenAI-compatible endpoint. Verda vLLM: http://<instance-ip>:8000/v1
# Fallback: https://api.mistral.ai/v1 with AI_MODEL=mistral-large-latest
# Leave AI_BASE_URL empty to run with built-in heuristic fallbacks.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=mistralai/Mistral-Large-3-675B-Instruct-2512-NVFP4
